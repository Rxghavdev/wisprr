{
  "manifest_version": 3,
  "name": "wisprr",
  "version": "0.1.0",
  "description": "An Ethereum wallet.",
  "action": {
    "default_title": "wisprr",
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "app.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": { "128": "icon.png" },
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "sandbox": {
    "pages": ["anon-rpc/*/sandbox.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; child-src 'self' blob:; worker-src 'self' blob:; connect-src *;"
  }
}
